# Public addresses being monitored. Use name:wallet entries separated by commas.
# TARGET_WALLET remains a backwards-compatible single-wallet fallback.
TRADING_MODE=paper
TARGET_WALLET=
TARGET_WALLETS=trader1:REPLACE_WITH_SOLANA_WALLET,trader2:REPLACE_WITH_SOLANA_WALLET
# In live mode only these configured names/addresses may send real orders.
# Other TARGET_WALLETS are monitored and written as trader_monitor_only skips.
LIVE_TRADER_WALLETS=trader1

# A private/dedicated RPC is faster and more reliable than Solana's public RPC.
RPC_HTTP_URL=https://api.mainnet-beta.solana.com
RPC_FALLBACK_HTTP_URL=
RPC_WS_URL=wss://api.mainnet-beta.solana.com
RPC_FALLBACK_WS_URL=
RPC_FALLBACK_WS_STAGGER_MS=30000
# Local/offline research should use a separate endpoint and is never deployed.
ANALYTICS_RPC_HTTP_URL=https://api.mainnet-beta.solana.com

# Paper-mode risk settings.
PAPER_TRADE_SOL=0.015
MAX_OPEN_POSITIONS=1
MAX_DAILY_LOSS_SOL=0.02
MAX_SIGNAL_AGE_MS=5000
LATENCY_PENALTY_BPS=300
PUMP_FEE_BPS=125

# The HTTP poll repairs gaps after WebSocket disconnects or server restarts.
POLL_INTERVAL_MS=15000
RPC_TIMEOUT_MS=10000
MAX_RPC_SILENCE_MS=300000
STARTUP_BACKFILL_MS=120000
FAST_SIGNAL_ENABLED=true
# Explicit traders that may act directly on authenticated processed Pump logs.
# Others still wait for the confirmed-transaction verification gate.
FAST_TRADER_WALLETS=none
FAST_MAX_SIGNAL_AGE_MS=1500
FAST_MAX_ENTRY_DRIFT_BPS=2500
# Skipping simulation saves latency but is only used for FAST_TRADER_WALLETS.
FAST_SKIP_SIMULATION=false
FAST_SHADOW_PROBE_ENABLED=true
FALLBACK_CONCURRENCY=8

# In live mode, every monitored trader also gets an independent simulated
# portfolio. This is how candidates are compared before enabling real orders.
SHADOW_ENABLED=true
SHADOW_TRADE_SOL=0.005
SHADOW_MAX_OPEN_POSITIONS_PER_TRADER=5
SHADOW_MAX_DAILY_LOSS_SOL=1
SHADOW_LATENCY_PENALTY_BPS=300
# Estimated fixed cost per transaction: priority fee + sender tip + base fee.
SHADOW_TX_FEE_SOL=0.00011
SHADOW_LOG_FILE=./data/shadow-trades.jsonl
SHADOW_STATE_DIR=./data/shadow-state

LOG_FILE=./data/paper-trades.jsonl
STATE_FILE=./data/paper-state.json
INGESTION_STATE_FILE=./data/ingestion-state.json

# Live mode remains physically disabled until all three are set deliberately:
# TRADING_MODE=live
# LIVE_CONFIRMATION=I_UNDERSTAND_REAL_FUNDS
# LIVE_WALLET_FILE=/absolute/path/to/a/chmod-600-solana-keypair.json
LIVE_WALLET_ADDRESS=
LIVE_TRADE_SOL=0.005
LIVE_MAX_DAILY_SPEND_SOL=0.03
LIVE_MIN_RESERVE_SOL=0.02
LIVE_SLIPPAGE_BPS=1500
LIVE_COMPUTE_UNIT_LIMIT=400000
LIVE_PRIORITY_FEE_SOL=0.0001

# rpc, jito, helius-swqos, or helius-max. SWQOS is the low-cost default.
LIVE_SEND_ROUTE=helius-swqos
LIVE_TIP_SOL=0.000005
LIVE_SIMULATE=true
LIVE_MEV_PROTECT=true
LIVE_CONFIRMATION_TIMEOUT_MS=45000
LIVE_BLOCKHASH_REFRESH_MS=2000
LIVE_MARKET_CACHE_MS=2000
LIVE_PROCESSED_BALANCE_TIMEOUT_MS=3000
LIVE_PROCESSED_BALANCE_POLL_MS=100
LIVE_MAX_DAILY_LOSS_SOL=0.01
LIVE_MAX_CONSECUTIVE_LOSSES=3
LIVE_MAX_HOLD_MS=3600000
LIVE_MAX_ENTRY_DRIFT_BPS=500
LIVE_EXIT_RETRY_BASE_MS=5000
LIVE_EXIT_RETRY_MAX_MS=60000
LIVE_MAINTENANCE_INTERVAL_MS=5000
HELIUS_API_KEY=
HELIUS_SENDER_URL=https://sender.helius-rpc.com/fast
JITO_URL=https://mainnet.block-engine.jito.wtf

# Used only for composite Pump/Raydium routes. Keyless works for testing at
# 0.5 RPS; set a free Jupiter key before production live trading.
JUPITER_API_URL=https://api.jup.ag/swap/v2
JUPITER_API_KEY=
# Preferred on a server: keep the key out of the environment file.
JUPITER_API_KEY_FILE=
JUPITER_TIMEOUT_MS=3000

# Keep the Telegram token in a chmod-600 file, never in this environment file.
TELEGRAM_BOT_TOKEN_FILE=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_STATUS_INTERVAL_MS=21600000

LIVE_KILL_SWITCH_FILE=./data/STOP_LIVE
LIVE_AUTO_PAUSE_FILE=./data/AUTO_PAUSE_BUYS
LIVE_LOG_FILE=./data/live-trades.jsonl
LIVE_STATE_FILE=./data/live-state.json
